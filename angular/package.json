{
  "name": "angular-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "npm run icons",
    "icons": "node scripts/generate-icons.mjs",
    "start": "npm run icons && ng serve showcase",
    "build": "npm run icons && ng build lumen-ui",
    "build:showcase": "npm run icons && ng build showcase",
    "watch": "npm run icons && ng build lumen-ui --watch --configuration development",
    "pack": "npm run build && npm pack ./dist/lumen-ui",
    "storybook": "npm run icons && ng run lumen-ui:storybook",
    "build-storybook": "npm run icons && ng run lumen-ui:build-storybook",
    "test": "npm run icons && ng test lumen-ui"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.8.1",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}

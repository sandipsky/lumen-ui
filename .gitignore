# ------------------------------------------------------------
# LumenUI monorepo — applies to angular/ and react/
# ------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
dist/
dist-showcase/
storybook-static/
dist-ssr/
out-tsc/
build/
*.tsbuildinfo

# Angular
.angular/
# Icon modules generated from icons/ by angular/scripts/generate-icons.mjs
/angular/projects/lumen-ui/src/lib/components/ui/icon/svg/
.nx/
/angular/bazel-out/

# Vite
.vite/
vite.config.*.timestamp-*
vite.config.ts.timestamp-*

# Packed library tarballs (npm pack / npm run tarball)
*.tgz
/tarballs/

# Test & coverage
coverage/
.nyc_output/
test-results/
playwright-report/
/libpeerconnection.log
testem.log
/typings

# Caches
.cache/
.eslintcache
.stylelintcache
.sass-cache/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables
.env
.env.*
!.env.example

# Editors & IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Claude Code (personal settings only; shared project settings stay tracked)
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Combined Storybook output (scripts/combine-storybooks.mjs)
/site/
